cmake_minimum_required(VERSION 3.11)
set(expected_hash 4f4eff756d475bd5ab1b6f3a569e57a6d51123e4509aab0c30921ee065b64928)
set(test_dir "${CMAKE_CURRENT_BINARY_DIR}/SFEditor-game-data")
set(log_dir "${test_dir}/logs")
file(MAKE_DIRECTORY "${log_dir}")
set(summary "${test_dir}/summary-all.md")
file(WRITE "${summary}" "### SFEditor test results\n\n| Resource | Files | Result |\n| --- | ---: | --- |\n")
if(NOT ARCHIVE)
    set(ARCHIVE "${test_dir}/sf3000.zip")
    # Discard a corrupt automatic cache, including an empty file left by an
    # interrupted download. Never remove an explicitly supplied archive.
    if(EXISTS "${ARCHIVE}")
        file(SHA256 "${ARCHIVE}" cached_hash)
        if(NOT cached_hash STREQUAL expected_hash)
            file(REMOVE "${ARCHIVE}")
        endif()
    endif()
    if(NOT EXISTS "${ARCHIVE}")
        set(partial "${ARCHIVE}.part")
        file(WRITE "${log_dir}/download.log" "Downloading game archive\n")
        foreach(attempt RANGE 1 3)
            if(attempt GREATER 1)
                execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
            endif()
            file(REMOVE "${partial}")
            # EXPECTED_HASH makes CMake abort on network failure before the
            # STATUS result can be handled. Check the digest ourselves.
            file(DOWNLOAD
                "http://www.starfighter.acornarcade.com/download/sf3000.zip"
                "${partial}" STATUS status TIMEOUT 20)
            list(GET status 0 result)
            if(result EQUAL 0)
                file(SHA256 "${partial}" downloaded_hash)
                if(downloaded_hash STREQUAL expected_hash)
                    file(RENAME "${partial}" "${ARCHIVE}")
                    file(APPEND "${log_dir}/download.log" "Attempt ${attempt}: verified archive\n")
                    break()
                endif()
                set(status "Game archive checksum mismatch")
            endif()
            file(APPEND "${log_dir}/download.log" "Attempt ${attempt}: ${status}\n")
            message(STATUS "Game archive download attempt ${attempt} failed: ${status}")
            file(REMOVE "${partial}")
        endforeach()
        if(NOT EXISTS "${ARCHIVE}")
            file(APPEND "${summary}" "| Game archive download | 0 | FAILED |\n")
            message(FATAL_ERROR "Cannot download game data after 3 attempts: ${status}; see ${log_dir}/download.log")
        endif()
    endif()
endif()
file(SHA256 "${ARCHIVE}" actual_hash)
if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Game archive checksum mismatch: ${ARCHIVE}")
endif()
set(data_dir "${test_dir}/data")
if(NOT EXISTS "${data_dir}/.extracted")
    file(REMOVE_RECURSE "${data_dir}")
    file(MAKE_DIRECTORY "${data_dir}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${ARCHIVE}"
        WORKING_DIRECTORY "${data_dir}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot extract game data")
    endif()
    file(WRITE "${data_dir}/.extracted" "${expected_hash}\n")
endif()
set(landscapes "${data_dir}/!Star3000/LandScapes")
if(NOT IS_DIRECTORY "${landscapes}")
    message(FATAL_ERROR "Missing LandScapes directory: ${landscapes}")
endif()
set(stdout_log "${log_dir}/tests.stdout.log")
set(stderr_log "${log_dir}/tests.stderr.log")
execute_process(COMMAND "${TEST_PROGRAM}"
    WORKING_DIRECTORY "${data_dir}/!Star3000"
    OUTPUT_FILE "${stdout_log}" ERROR_FILE "${stderr_log}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    file(APPEND "${summary}" "| SFEditorTests | - | FAILED |\n")
    foreach(log IN ITEMS "${stdout_log}" "${stderr_log}")
        file(STRINGS "${log}" lines)
        list(LENGTH lines line_count)
        if(line_count GREATER 30)
            math(EXPR start "${line_count} - 30")
            list(SUBLIST lines ${start} 30 lines)
        endif()
        string(REPLACE ";" "\n" tail "${lines}")
        message("${log}:\n${tail}")
    endforeach()
    message(FATAL_ERROR "SFEditorTests failed: ${result}; full logs: ${log_dir}")
endif()
foreach(kind map objects graphics tiles-dark tiles-bright colours hills mission)
    file(STRINGS "${stdout_log}" loaded REGEX "^Loading ${kind}: ")
    list(LENGTH loaded count)
    file(APPEND "${summary}" "| ${kind} | ${count} | passed |\n")
endforeach()
file(APPEND "${summary}" "| Unit suites | 16 | passed |\n")
message(STATUS "All unit and loading tests passed; logs: ${log_dir}")
